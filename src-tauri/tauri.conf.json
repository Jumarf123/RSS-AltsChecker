{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AltsChecker",
  "version": "1.1.0",
  "identifier": "com.rss.altschecker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AltsChecker",
        "width": 1160,
        "height": 780,
        "minWidth": 860,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Jumarf",
    "copyright": "Copyright (c) 2026 Jumarf",
    "shortDescription": "AltsChecker",
    "longDescription": "AltsChecker by Jumarf",
    "icon": ["../newico/ico.ico"],
    "windows": {
      "wix": {
        "upgradeCode": "a0d0f300-4b5c-5bf0-b9fd-1e7f7068a933"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      }
    }
  }
}
